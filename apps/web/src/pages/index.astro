---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSectionOld from '../components/HeroSectionold.astro';
import HeroSection from '../components/HeroSection.astro';
import ProjectsPreview from '../components/ProjectsPreview.astro';
import AboutPreview from '../components/AboutPreview.astro';
import GitHubContributions from '../components/GitHubContributions.astro';
import WorkExperience from '../components/WorkExperience.astro';
import ContactStrip from '../components/ContactStrip.astro';
import { getLang } from '../lib/i18n';

const lang = getLang(Astro.currentLocale);
---

<BaseLayout>
  <HeroSection lang={lang} />
  <!-- <HeroSectionOld /> -->
  <ProjectsPreview server:defer lang={lang} />
  <GitHubContributions lang={lang} />
  <AboutPreview lang={lang} />
  <WorkExperience server:defer lang={lang} />
  <ContactStrip lang={lang} />
</BaseLayout>
