---
import nilsPhoto1 from '../public/images/1732207667226.jpg';
import nilsPhoto2 from '../public/images/file_00000000b9287246ab5a6e2981f57770.png';
import nilsPhoto3 from '../public/images/WIN_20250831_01_33_17_Pro.jpg';
import { t, type Lang } from '@portfolio/data';
import { getLang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = getLang(Astro.currentLocale) } = Astro.props;
---

<div class="hero-mosaic hero-fade relative z-10 justify-self-center md:justify-self-start" style="animation-delay: 80ms" data-mosaic-root>
  <div class="mosaic-stage" data-mosaic-stage>
    <div class="mosaic-glow" aria-hidden="true"></div>

    <div class="mosaic-shell mosaic-shell-left" data-mosaic-card="left">
      <div class="mosaic-idle">
        <div class="mosaic-fan">
          <button class="mosaic-card mosaic-card-left" type="button" aria-label={t(lang, 'hero.mosaic.previous')}>
            <img src={nilsPhoto1.src} alt="" class="mosaic-image mosaic-image-left" />
          </button>
        </div>
      </div>
    </div>

    <div class="mosaic-shell mosaic-shell-center" data-mosaic-card="center">
      <div class="mosaic-idle">
        <div class="mosaic-fan">
          <button class="mosaic-card mosaic-card-center" type="button" aria-label={t(lang, 'hero.mosaic.open')}>
            <img src={nilsPhoto2.src} alt="Nils Mertens" class="mosaic-image mosaic-image-center" />
          </button>
        </div>
      </div>
    </div>

    <div class="mosaic-shell mosaic-shell-right" data-mosaic-card="right">
      <div class="mosaic-idle">
        <div class="mosaic-fan">
          <button class="mosaic-card mosaic-card-right" type="button" aria-label={t(lang, 'hero.mosaic.next')}>
            <img src={nilsPhoto3.src} alt="" class="mosaic-image mosaic-image-right" />
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="mosaic-footer">
    <div class="mosaic-controls" aria-label={t(lang, 'hero.mosaic.controls')}>
      <button class="mosaic-arrow" type="button" data-mosaic-action="previous" aria-label={t(lang, 'hero.mosaic.previous')}>
        <span aria-hidden="true">↙</span>
      </button>
      <button class="mosaic-arrow" type="button" data-mosaic-action="next" aria-label={t(lang, 'hero.mosaic.next')}>
        <span aria-hidden="true">↗</span>
      </button>
    </div>
  </div>
</div>

<style>
  .hero-mosaic {
    width: min(100%, 25rem);
  }

  .mosaic-stage {
    position: relative;
    width: 100%;
    height: 22rem;
  }

  .mosaic-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 0;
    width: 72%;
    height: 76%;
    border-radius: 50%;
    background: rgba(216, 95, 163, 0.32);
    filter: blur(34px);
    opacity: 0.55;
    pointer-events: none;
    transform: translate(-50%, -50%);
    animation: mosaicGlow 3.4s ease-in-out infinite;
  }

  /* Shells change carousel positions, fans spread, and cards rotate. */
  .mosaic-shell {
    position: absolute;
    top: 4%;
    width: 57%;
    height: 88%;
    transition:
      left 700ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mosaic-shell-left {
    left: 3%;
    z-index: 1;
    filter: saturate(0.55) brightness(0.72);
  }

  .mosaic-shell-center {
    left: 21.5%;
    z-index: 3;
    filter: saturate(0.9) contrast(1.05);
  }

  .mosaic-shell-right {
    left: 40%;
    z-index: 1;
    filter: saturate(0.55) brightness(0.72);
  }

  .mosaic-idle {
    width: 100%;
    height: 100%;
  }

  .mosaic-fan {
    width: 100%;
    height: 100%;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mosaic-stage:hover .mosaic-shell-left .mosaic-fan {
    transform: translateX(-1rem);
  }

  .mosaic-stage:hover .mosaic-shell-right .mosaic-fan {
    transform: translateX(1rem);
  }

  .mosaic-card {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(216, 95, 163, 0.5);
    border-radius: 0.5rem;
    background: #2a2440;
    box-shadow: 0 0 28px rgba(216, 95, 163, 0.14);
    cursor: pointer;
    transition:
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 700ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mosaic-card-left {
    transform: translate(-0.5rem, 0.8rem) rotate(-10deg) scale(0.94);
  }

  .mosaic-card-center {
    border-color: rgba(245, 208, 96, 0.65);
    transform: scale(1);
  }

  .mosaic-card-right {
    transform: translate(0.5rem, 0.8rem) rotate(10deg) scale(0.94);
  }

  .mosaic-card:hover,
  .mosaic-card:focus-visible {
    border-color: rgba(245, 208, 96, 0.7);
    box-shadow: 0 0 24px rgba(245, 208, 96, 0.18);
    outline: none;
  }

  .mosaic-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 700ms ease;
  }

  .mosaic-image-left {
    object-position: 25% 20%;
  }

  .mosaic-image-center {
    object-position: center top;
  }

  .mosaic-image-right {
    object-position: 75% 65%;
  }

  .mosaic-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 1rem;
    padding-inline: 0.5rem;
  }

  .mosaic-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .mosaic-arrow {
    display: grid;
    width: 2.6rem;
    height: 2rem;
    place-items: center;
    color: #f5d060;
    font-size: 1.8rem;
    font-weight: 300;
    line-height: 1;
    cursor: pointer;
    transition: color 180ms ease, transform 180ms ease, text-shadow 180ms ease;
  }

  .mosaic-arrow:hover,
  .mosaic-arrow:focus-visible {
    color: #d85fa3;
    text-shadow: 0 0 14px rgba(216, 95, 163, 0.65);
    outline: none;
    transform: translateY(-2px) scale(1.12);
  }

  @keyframes mosaicGlow {
    0%, 100% {
      opacity: 0.4;
      transform: translate(-50%, -50%) scale(0.92);
    }
    50% {
      opacity: 0.85;
      transform: translate(-50%, -50%) scale(1.08);
    }
  }

  @keyframes mosaicSpreadLeft {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(-1rem); }
  }

  @keyframes mosaicSpreadRight {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(1rem); }
  }

  .mosaic-shell-left .mosaic-idle {
    animation: mosaicSpreadLeft 5.5s ease-in-out infinite;
  }

  .mosaic-shell-right .mosaic-idle {
    animation: mosaicSpreadRight 5.5s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .mosaic-shell,
    .mosaic-idle,
    .mosaic-fan,
    .mosaic-card,
    .mosaic-arrow {
      transition: none;
    }

    .mosaic-glow,
    .mosaic-shell-left .mosaic-idle,
    .mosaic-shell-right .mosaic-idle {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .hero-mosaic {
      width: min(88vw, 22rem);
    }

    .mosaic-stage {
      height: 20rem;
    }
  }
</style>

<script>
  const root = document.querySelector('[data-mosaic-root]');
  const stage = root?.querySelector('[data-mosaic-stage]');
  const cardShells = stage ? Array.from(stage.querySelectorAll('[data-mosaic-card]')) : [];
  const previous = root?.querySelector('[data-mosaic-action="previous"]');
  const next = root?.querySelector('[data-mosaic-action="next"]');
  let active = 0;

  function updateMosaic(direction = 0) {
    active = (active + direction + 3) % 3;
    const positions = ['left', 'center', 'right'];
    const current = positions[active];
    const left = positions[(active + 2) % 3];
    const right = positions[(active + 1) % 3];

    cardShells.forEach((cardShell) => {
      const card = cardShell.querySelector('.mosaic-card');
      const position = cardShell.dataset.mosaicCard;
      const role = position === current ? 'center' : position === left ? 'left' : 'right';

      cardShell.classList.remove('mosaic-shell-left', 'mosaic-shell-center', 'mosaic-shell-right');
      cardShell.classList.add(`mosaic-shell-${role}`);

      card?.classList.remove('mosaic-card-left', 'mosaic-card-center', 'mosaic-card-right');
      card?.classList.add(`mosaic-card-${role}`);

      const image = card?.querySelector('img');
      if (image) image.className = `mosaic-image mosaic-image-${role}`;
    });
  }

  previous?.addEventListener('click', () => updateMosaic(-1));
  next?.addEventListener('click', () => updateMosaic(1));
  cardShells.forEach((cardShell) => cardShell.addEventListener('click', () => {
    const position = cardShell.dataset.mosaicCard;
    if (position === 'left') updateMosaic(-1);
    if (position === 'right') updateMosaic(1);
  }));
</script>
