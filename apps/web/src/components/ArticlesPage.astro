---
import { getArticles, getProjects, t, type Lang } from '@portfolio/data';
import SectionHeader from './SectionHeader.astro';
import { articleHref } from '../lib/articles';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const articles = getArticles({ status: 'published' }, lang);
const projectTitles = new Map(
  getProjects({}, lang).map((project) => [project.id, project.title] as const),
);

const latest = articles[0];
const rest = articles.slice(1);
---

<section class="pt-14 pb-20">
  <div class="container">
    <div class="page-fade">
      <SectionHeader
        label={t(lang, 'articles.page.label')}
        title={t(lang, 'articles.page.title')}
        as="h1"
      />

      <div class="space-y-5">
        <p class="text-xl md:text-2xl text-foreground/90 leading-relaxed">
          {t(lang, 'articles.page.intro')}
        </p>
        <p class="text-base text-muted-foreground leading-relaxed">
          {t(lang, 'articles.page.intro2')}
        </p>
      </div>
    </div>

    {
      articles.length === 0 ? (
        <p class="mt-12 max-w-2xl text-muted-foreground leading-relaxed">
          {t(lang, 'articles.page.empty')}
        </p>
      ) : (
        <>
          {/* Latest — no card: title (yellow) / description / date + project — button to the right */}
          <div class="card-reveal mt-12 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
            <div class="flex-1 min-w-0">
              <h2 class="text-2xl font-bold leading-tight text-primary md:text-3xl">
                <a href={articleHref(latest, lang)} class="hover:text-primary transition-colors">
                  {latest.title}
                </a>
              </h2>

              {latest.summary && (
                <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-foreground/80 md:text-base">
                  {latest.summary}
                </p>
              )}

              <div class="mt-3 flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.08em]">
                <time
                  datetime={latest.published_at ?? latest.created_at}
                  class="text-muted-foreground tabular-nums"
                >
                  {(latest.published_at ?? latest.created_at).slice(0, 10)}
                </time>
                {latest.project_id && projectTitles.get(latest.project_id) && (
                  <span class="text-pink truncate">▸ {projectTitles.get(latest.project_id)}</span>
                )}
              </div>
            </div>

            <a href={articleHref(latest, lang)} class="btn btn-primary shrink-0 self-start md:self-center">
              {t(lang, 'articles.readArticle')} →
            </a>
          </div>

          {/* Older articles — table-like rows, same language as WorkExperience minus the avatar/accent */}
          {rest.length > 0 && (
            <div class="mt-10 flex flex-col">
              {rest.map((article, i) => {
                const href = articleHref(article, lang);
                const date = (article.published_at ?? article.created_at).slice(0, 10);
                const projectTitle = article.project_id
                  ? projectTitles.get(article.project_id)
                  : undefined;
                return (
                  <a
                    href={href}
                    class="article-row group flex items-start gap-4 py-4 px-3 -mx-3 rounded-md"
                    style={`--delay: ${Math.min(i * 60, 300)}ms`}
                  >
                    <div class="flex-1 min-w-0">
                      <div class="flex items-baseline justify-between gap-4 flex-wrap">
                        <h3 class="text-sm font-semibold leading-tight text-foreground transition-colors group-hover:text-primary">
                          {article.title}
                        </h3>
                        <time
                          datetime={article.published_at ?? article.created_at}
                          class="shrink-0 text-[11px] tabular-nums text-foreground/55"
                        >
                          {date}
                        </time>
                      </div>

                      {article.summary && (
                        <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-foreground/70">
                          {article.summary}
                        </p>
                      )}

                      {projectTitle && (
                        <p class="mt-1.5 text-[11px] font-medium uppercase tracking-[0.06em] text-pink">
                          ▸ {projectTitle}
                        </p>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          )}
        </>
      )
    }
  </div>
</section>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .page-fade {
    opacity: 0;
    animation: fadeUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .card-reveal {
    opacity: 0;
    animation: fadeUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: var(--delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .page-fade,
    .card-reveal {
      animation: none;
      opacity: 1;
    }
  }

  .article-row {
    transition: background-color 250ms ease;
  }

  .article-row:hover {
    background-color: rgba(255, 255, 255, 0.018);
  }

  .article-row:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
</style>
