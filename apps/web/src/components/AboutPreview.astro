---
import SectionHeader from './SectionHeader.astro';
import SkillsGrid from './SkillsGrid.astro';
import { getAbout, t, type Lang } from '@portfolio/data';
import { getLang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = getLang(Astro.currentLocale) } = Astro.props;
const about = getAbout(lang);
---

<section class="py-16">
  <div class="container">
    <SectionHeader
      label={t(lang, 'nav.about')}
      title={t(lang, 'about.title')}
      ctaHref={lang === 'en' ? '/en/about' : '/about'}
      ctaLabel={t(lang, 'cta.readMore')}
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div class="flex flex-col gap-4">
        {about?.bio_landing.map((paragraph) => (
          <p class="text-foreground leading-[1.7]">{paragraph}</p>
        ))}
        <p class="text-foreground leading-[1.7]">
          {t(lang, 'about.intro.githubNote')}
          <a href={about?.github_url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">GitHub</a>.
        </p>
        <div class="flex flex-wrap gap-2 mt-2 items-center">
          <span class="text-[11px] font-medium text-foreground/70">📍 {about?.location}</span>
          <span class="text-[11px] font-medium text-foreground/70">🎓 AP Hogeschool</span>
          {about?.status_active && (
            <span class="inline-block py-0.5 px-2.5 rounded-full text-[11px] font-medium uppercase tracking-[0.06em] text-primary bg-primary/10 border border-primary/30">
              {about?.status_label}
            </span>
          )}
        </div>
      </div>

      <div>
        <SkillsGrid />
      </div>
    </div>
  </div>
</section>
