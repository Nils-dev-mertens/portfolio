---
import { type Project, type ProjectCategory, t, type Lang } from '@portfolio/data';
import { getLang } from '../lib/i18n';

interface Props {
  project: Project;
  wide?: boolean;
  isLatest?: boolean;
  lang?: Lang;
}

const { project, wide = false, isLatest = false, lang = getLang(Astro.currentLocale) } = Astro.props;

/**
 * Every category carries its own accent colour and its own marker, so a card
 * reads differently depending on what kind of project it is. The markers use the
 * vocabulary of the category: a URL for a website, a shell prompt for a CLI,
 * a request line for an API, an import for a library, and so on.
 */
const CATEGORY_META: Record<ProjectCategory, { labelKey: string; accent: string; marker: string }> = {
  website: { labelKey: 'projects.category.website', accent: '#d85fa3', marker: 'http://' },
  cli: { labelKey: 'projects.category.cli', accent: '#f5d060', marker: '$' },
  api: { labelKey: 'projects.category.api', accent: '#9d8cf7', marker: 'GET /' },
  library: { labelKey: 'projects.category.library', accent: '#58c7e0', marker: 'import' },
  tool: { labelKey: 'projects.category.tool', accent: '#6fd8bf', marker: '▸' },
  other: { labelKey: 'projects.category.other', accent: '#c8c0e8', marker: '//' },
};

const meta = CATEGORY_META[project.category] ?? CATEGORY_META.other;
const year = project.created_at.slice(0, 4);
const hasActions = Boolean(project.url || project.repo_url);
const titleHref = project.url ?? project.repo_url;
---

<article
  class:list={[
    'project-card bg-card border border-border rounded-lg flex flex-col h-full',
    wide ? 'p-6 gap-5' : 'p-4 gap-4',
  ]}
  style={`--accent: ${meta.accent}`}
>
  <!-- Category strip — colour + marker + year/newest -->
  <div class="card-chrome flex items-center gap-2 pb-3">
    <span class="cat-marker" aria-hidden="true">{meta.marker}</span>
    <span class="cat-label text-[11px] font-semibold uppercase tracking-[0.08em]">
      {t(lang, meta.labelKey)}
    </span>
    <span class="flex-1"></span>
    {isLatest ? (
      <span class="latest-badge">{t(lang, 'projects.latest')}</span>
    ) : (
      <span class="text-[11px] tabular-nums text-muted-foreground">{year}</span>
    )}
  </div>

  {wide ? (
    /* Wide (featured) layout — text left, tags right */
    <div class="flex flex-col md:flex-row gap-6 flex-1">
      <div class="flex flex-col gap-3 flex-1 min-w-0">
        <h3 class="text-2xl font-bold text-primary leading-tight">
          {titleHref ? (
            <a class="card-title" href={titleHref} target="_blank" rel="noopener noreferrer">
              {project.title}
            </a>
          ) : (
            project.title
          )}
        </h3>
        <p class="text-foreground/80 leading-relaxed">{project.description}</p>
      </div>

      <div class="flex flex-wrap gap-1 md:justify-end md:max-w-[50%] md:content-start">
        {project.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>
  ) : (
    /* Default compact layout */
    <>
      <h3 class="text-xl font-semibold text-primary leading-tight">
        {titleHref ? (
          <a class="card-title" href={titleHref} target="_blank" rel="noopener noreferrer">
            {project.title}
          </a>
        ) : (
          project.title
        )}
      </h3>

      <p class="text-sm text-foreground/80 leading-relaxed flex-1">{project.description}</p>

      <div class="flex flex-wrap gap-1">
        {project.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </>
  )}

  {hasActions && (
    <div class="card-actions">
      {project.url && (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="card-btn card-btn-primary"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
          {t(lang, 'projects.visitSite')}
        </a>
      )}

      {project.repo_url && (
        <a
          href={project.repo_url}
          target="_blank"
          rel="noopener noreferrer"
          class="card-btn card-btn-ghost"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          {t(lang, 'projects.viewCode')}
        </a>
      )}
    </div>
  )}
</article>

<style>
  .project-card {
    position: relative;
    /* The category colour reads as a coloured top edge on every card. */
    border-top: 2px solid color-mix(in srgb, var(--accent) 65%, transparent);
    transition:
      border-color 200ms ease,
      transform 200ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 200ms ease;
  }

  .project-card:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    transform: translateY(-4px);
    box-shadow: 0 8px 28px color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .card-chrome {
    border-bottom: 1px dashed color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .cat-marker {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 11px;
    line-height: 1;
    color: var(--accent);
  }

  .cat-label {
    color: var(--accent);
  }

  .card-title {
    color: inherit;
    transition: color 150ms ease;
  }

  .card-title:hover {
    color: var(--accent);
  }

  .project-card .tag {
    color: var(--accent);
    background-color: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 28%, transparent);
  }

  /* Actions — always visible, sized as real buttons */
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .card-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.5rem 0.8rem;
    border-radius: calc(var(--radius) * 0.8);
    border: 1px solid transparent;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      color 150ms ease;
  }

  .card-btn-primary {
    color: var(--accent);
    background-color: color-mix(in srgb, var(--accent) 16%, transparent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .card-btn-primary:hover {
    background-color: color-mix(in srgb, var(--accent) 28%, transparent);
    border-color: var(--accent);
  }

  .card-btn-ghost {
    color: color-mix(in srgb, var(--foreground) 85%, transparent);
    border-color: var(--border);
  }

  .card-btn-ghost:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background-color: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .card-title:focus-visible,
  .card-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: calc(var(--radius) * 0.6);
  }

  .latest-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 9999px;
    background-color: color-mix(in srgb, var(--color-pink, #d85fa3) 15%, transparent);
    color: var(--color-pink, #d85fa3);
    border: 1px solid color-mix(in srgb, var(--color-pink, #d85fa3) 40%, transparent);
    white-space: nowrap;
  }
</style>
