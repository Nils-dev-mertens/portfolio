---
import { buttonVariants } from './ui/button';
import HeroPhotoMosaic from './HeroPhotoMosaic.astro';
import { getAbout, t, type Lang } from '@portfolio/data';
import { getLang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = getLang(Astro.currentLocale) } = Astro.props;
const about = getAbout(lang);
const projectsHref = lang === 'en' ? '/en/projects' : '/projects';
const aboutHref = lang === 'en' ? '/en/about' : '/about';
---

<section class="hero relative isolate overflow-hidden">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="container relative grid min-h-[calc(80svh-60px)] grid-cols-1 items-center gap-12 py-16 md:grid-cols-[minmax(280px,0.9fr)_minmax(0,1.1fr)] md:gap-16 md:py-20">
    <HeroPhotoMosaic lang={lang} />

    <div class="relative z-10 max-w-2xl">
      <h1 class="hero-title hero-fade text-[56px] font-bold leading-none text-primary md:text-[72px]" style="animation-delay: 160ms">
        Nils Mertens
      </h1>

      <div class="mt-4 max-w-xl hero-fade" style="animation-delay: 260ms">
        <p class="text-lg leading-[1.7] text-foreground/70 md:text-xl">
          {about?.tagline}
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={projectsHref} class={buttonVariants({ size: 'lg' })}>
            {t(lang, 'cta.viewProjects')}
          </a>
          <a href={aboutHref} class={buttonVariants({ variant: 'outline', size: 'lg' })}>
            {t(lang, 'cta.about')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(80svh - 60px);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.28;
    background-image:
      linear-gradient(rgba(216, 95, 163, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(216, 95, 163, 0.08) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to right, black, transparent 82%);
  }

  .hero-title {
    text-shadow: 0 0 42px rgba(245, 208, 96, 0.08);
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-fade {
    opacity: 0;
    animation: fadeUp 0.55s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade {
      opacity: 1;
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: auto;
    }

    .hero-grid {
      mask-image: linear-gradient(to bottom, black, transparent 75%);
    }
  }
</style>
