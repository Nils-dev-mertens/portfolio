# Portfolio Website - Environment Variables

# Database configuration
DB_PATH=./portfolio.db

# Web server configuration
HOST=0.0.0.0
PORT=4321

# Development mode (set to 'development' for dev, 'production' for prod)
NODE_ENV=development

# API base URL. The dashboard calls the API on its own origin (`/api/...`),
# which nginx maps to the api service in production. During `turbo run dev`
# there is no nginx, so the dashboard dev server proxies `/api` to this URL.
API_URL=http://localhost:3001

# ── GitHub contributions cronjob ────────────────────────────────────
# Personal Access Token with read:user scope.
# Create one at https://github.com/settings/tokens (classic: read:user,
# fine-grained: Account > Account permissions > "Your profile information" read)
GITHUB_TOKEN=
# GitHub username to fetch contributions for. Defaults to the username
# in the `about` table's github_url if not set.
GITHUB_USERNAME=

# API auth (used by apps/api)
AUTH_SECRET=
AUTH_PASSWORD=

# Analytics (if applicable)
ANALYTICS_ID=

# ── DeepL (auto-generates English translations from Dutch source content) ──
# Get a key at https://www.deepl.com/pro-api (free tier: api-free.deepl.com)
DEEPL_API_KEY=
# Optional overrides:
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# DEEPL_TARGET_LANG=EN-US   # also: EN-GB

# Note: For Docker deployment, these variables are typically set in docker-compose.yml
# This file serves as documentation for local development