{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "typeRoots": ["../node_modules", "../packages/data/node_modules"],
    "types": ["bun-types"]
  },
  "include": ["./**/*.ts"]
}
